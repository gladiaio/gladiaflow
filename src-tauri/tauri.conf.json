{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "GladiaFlow",
  "version": "1.2.0",
  "identifier": "io.gladia.gladiaflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GladiaFlow",
        "width": 800,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "meeting-controller",
        "title": "GladiaFlow Meeting",
        "width": 140,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "meeting-reminder",
        "title": "GladiaFlow Meeting Reminder",
        "width": 660,
        "height": 156,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
