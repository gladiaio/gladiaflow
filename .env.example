# Certificate common name from Keychain Access (e.g. "GladiaFlow Self-Signed").
MACOS_SIGNING_IDENTITY=

# Tauri reads this at build time; set to the same value as MACOS_SIGNING_IDENTITY
# when building a signed macOS bundle locally.
APPLE_SIGNING_IDENTITY=

# Base64-encoded .p12 export (macOS CI: `base64 -i GladiaFlow.p12 | pbcopy`).
MACOS_CERTIFICATE=

# Password used when exporting the .p12.
MACOS_CERTIFICATE_PWD=

# Password for the temporary keychain created during CI signing.
KEYCHAIN_PASSWORD=

# --- Tauri updater artifact signing (optional) ---
# Generate with `tauri signer generate -w ~/.tauri/gladiaflow.key`.
# Only needed if you publish auto-updates with signed update bundles.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
